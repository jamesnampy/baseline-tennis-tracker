{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baseline-tennis-tracker",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The tracker is a client-side SPA: unknown paths must return index.html
    // rather than a 404, so deep links and the installed PWA both resolve.
    "not_found_handling": "single-page-application",
    // Everything except the API and server-rendered coach reports is served
    // straight from assets.
    "run_worker_first": ["/api/*", "/report/*"]
  },
  // Hosted event store for cloud sync and live spectator links.
  //
  // Create it once with `npx wrangler d1 create baseline-tennis-tracker` and paste
  // the returned id below, then apply the schema with `npm run db:migrate`. Until
  // then the binding resolves to nothing locally and every /api/v1 route answers
  // 503; tracking, export, and the strategy review are unaffected because the
  // device remains the authoritative store during a match.
  // One Durable Object per match. It serializes appends so server sequence
  // numbers never race, and fans new points out to live spectators over
  // WebSockets. Removing this binding degrades cleanly: sync and the API keep
  // working, only live updates stop.
  "durable_objects": {
    "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baseline-tennis-tracker",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./drizzle"
    }
  ]
}
