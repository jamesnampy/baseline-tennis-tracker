# Optional hosted AI strategy review. Tracking and the on-device review work without these.
# Without a key the app transparently falls back to its on-device evidence engine.
ANTHROPIC_API_KEY=

# Optional overrides. Defaults: provider `anthropic`, model `claude-opus-4-8`.
# STRATEGY_PROVIDER=anthropic
# STRATEGY_MODEL=claude-opus-4-8

# Password login for the app (requirements section 17). PBKDF2 hash of the
# account password, never the password itself; `npm run setup:cloudflare`
# generates it. Hosted access is DISABLED until this or SYNC_TOKEN is set:
# every /api/v1 route answers 503 and no device data is reachable.
AUTH_PASSWORD_HASH=

# Optional bearer credential for scripts and the read-only analysis API, where
# there is no browser to hold a session cookie. The app does not need it.
# Live spectator links carry their own per-link token and use neither value.
SYNC_TOKEN=
