# Optional hosted AI strategy review. Tracking and the on-device review work without these.
# Without a key the app transparently falls back to its on-device evidence engine.
ANTHROPIC_API_KEY=

# Optional overrides. Defaults: provider `anthropic`, model `claude-opus-4-8`.
# STRATEGY_PROVIDER=anthropic
# STRATEGY_MODEL=claude-opus-4-8

# Shared secret for cloud sync and the read-only analysis API (requirements
# section 17). Hosted access is DISABLED until this is set: every /api/v1 route
# answers 503 and no device data is reachable. Set it with
# `npx wrangler secret put SYNC_TOKEN` for a deployment, or here for local dev.
# Live spectator links carry their own per-link token and do not use this value.
SYNC_TOKEN=
