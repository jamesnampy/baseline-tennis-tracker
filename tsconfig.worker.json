{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "paths": {
      "@/*": ["./*"]
    }
  },
  // The Worker projects scores and statistics with the same `lib/tennis/` code the
  // client uses, so spectators and the API never see a second scoring engine.
  // `db/` stays out: it is the Drizzle migration source, not Worker runtime code.
  "include": ["worker/**/*.ts", "lib/**/*.ts"],
  // IndexedDB is the device's store and has no meaning in a Worker.
  "exclude": ["lib/tennis/storage.ts"]
}
